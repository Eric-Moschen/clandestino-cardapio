NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-chave-publishable

# Push notifications (VAPID). Generate keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=CHAVE_PUBLICA_VAPID
VAPID_PRIVATE_KEY=CHAVE_PRIVADA_VAPID
VAPID_SUBJECT=mailto:seu-email@dominio.com

# Server only. Never prefix with NEXT_PUBLIC_ or expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=CHAVE_SERVICE_ROLE_DO_SUPABASE

# URL pública usada para gerar links de QR Code (ex.: https://seu-dominio.com)
NEXT_PUBLIC_SITE_URL=
